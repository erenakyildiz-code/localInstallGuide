# ── Brain ────────────────────────────────────────────────────────────────
# File name of the GGUF inside ./GGUF (download from huggingface.co/unsloth)
BRAIN_MODEL=gemma-4-26B-A4B-it-UD-Q6_K_XL.gguf
# Context size in tokens. 26B Q6 + 171072 ctx fits a 24GB card; drop to 32768 on 12-16GB.
BRAIN_CTX=32768

# ── Ears ─────────────────────────────────────────────────────────────────
# tiny | base | small | medium | large-v3 | large-v3-turbo  (Systran faster-whisper IDs)
WHISPER_MODEL=Systran/faster-whisper-small

# ── Mouth ────────────────────────────────────────────────────────────────
# e.g. af_bella, af_heart, am_adam, bf_emma, bm_george — mixes work too: af_bella(2)+af_heart(1)
KOKORO_VOICE=af_bella

# Only needed for gated HuggingFace models; leave empty otherwise
HF_TOKEN=
